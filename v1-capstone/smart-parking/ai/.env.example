# ================================================
# 카메라 장치 (라즈베리파이 / 다른 PC) 에서 설정
# ================================================

# 메인 노트북(서버)의 IP 주소
# 같은 와이파이에 있다면 내부 IP (ipconfig로 확인)
# 예: 192.168.0.10
SERVER_IP=192.168.0.10

# ── RabbitMQ ─────────────────────────────────────────────
# SERVER_IP를 설정하면 자동으로 반영됨
# 직접 지정하고 싶으면 아래 주석 해제
# RABBIT_URL=amqp://app:apppass@192.168.0.10:5672
RABBIT_QUEUE=ai.events

# ── MediaMTX (CCTV 대시보드용 스트리밍) ─────────────────
# SERVER_IP를 설정하면 자동으로 반영됨
# MEDIAMTX_HOST=192.168.0.10
MEDIAMTX_RTSP_PORT=8554

# ── 카메라 소스 ───────────────────────────────────────────
# 로컬 웹캠 (USB 카메라, 노트북 카메라)
CAMERA_SOURCE=0

# 라즈베리파이 카메라
# CAMERA_SOURCE=/dev/video0

# 외부 RTSP 스트림
# CAMERA_SOURCE=rtsp://192.168.0.20:8554/stream

# 이 카메라의 식별 코드 (대시보드에서 보여줄 이름)
CAMERA_CODE=CAM-A-G-01
DEVICE_CODE=CAM-A-G-01

# ── YOLOv8 모델 ───────────────────────────────────────────
YOLO_MODEL=yolov8n.pt

# ── 분석 설정 ─────────────────────────────────────────────
FRAME_INTERVAL=2.0
CONFIDENCE_THRESHOLD=0.5

# ── 보안 ──
# MJPEG 영상: 다른 기기에서 보려면 관리자 로그인 토큰 필요 (백엔드 /auth/me 로 확인)
# BACKEND_URL=http://localhost:4000
# MJPEG_AUTH=off  # 영상 인증 끄기 (권장하지 않음)
# --server(Flask) 모드: 기본은 이 PC에서만. 외부에 열려면 둘 다 설정
# AI_SERVER_HOST=0.0.0.0
# AI_CONTROL_TOKEN=16자-이상의-임의-문자열
