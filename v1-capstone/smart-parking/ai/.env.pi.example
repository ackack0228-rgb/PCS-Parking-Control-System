# ================================================
# 라즈베리파이 + USB 웹캠 전용 설정
# 이 파일을 .env 로 복사해서 사용:  cp .env.pi.example .env
# ================================================

# 메인 노트북(서버) IP - 같은 와이파이에서 ipconfig로 확인
SERVER_IP=192.168.0.10

# RabbitMQ (SERVER_IP 기반으로 자동 설정됨)
RABBIT_QUEUE=ai.events

# USB 웹캠 (Pi에 연결된 웹캠)
CAMERA_SOURCE=0

# 이 카메라의 이름 (대시보드에서 표시될 이름)
CAMERA_CODE=CAM-A-G-01
DEVICE_CODE=CAM-A-G-01

# YOLOv8 nano (Pi에서 가장 빠름)
YOLO_MODEL=yolov8n.pt

# Pi 성능에 맞게 3초마다 분석 (너무 짧으면 과부하)
FRAME_INTERVAL=3.0
CONFIDENCE_THRESHOLD=0.5

# 구역에서 차량이 감지되지 않는 시간(초) → "차량 떠남" 이벤트 발행
# FRAME_INTERVAL의 5~10배 권장 (오탐 방지)
SPOT_CLEAR_TIMEOUT=15.0

# ================================================
# Jetson Orin Nano 권장 설정 (Pi보다 빠름)
# ================================================
# YOLO_MODEL=yolov8s.pt        # 더 정확한 모델 사용 가능
# FRAME_INTERVAL=0.5           # 0.5초마다 분석 (실시간에 가까움)
# SPOT_CLEAR_TIMEOUT=5.0       # FRAME_INTERVAL이 짧으니 타임아웃도 짧게

# ── 보안 ──
# MJPEG 영상: 다른 기기에서 보려면 관리자 로그인 토큰 필요 (백엔드 /auth/me 로 확인)
# BACKEND_URL=http://localhost:4000
# MJPEG_AUTH=off  # 영상 인증 끄기 (권장하지 않음)
# --server(Flask) 모드: 기본은 이 PC에서만. 외부에 열려면 둘 다 설정
# AI_SERVER_HOST=0.0.0.0
# AI_CONTROL_TOKEN=16자-이상의-임의-문자열
