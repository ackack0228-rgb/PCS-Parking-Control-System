# =========================
# Server
# =========================
PORT=4000

# =========================
# Database (MySQL - Docker)
# Windows 호스트에서 node 실행 -> localhost로 접근
# =========================
DB_HOST=localhost
DB_PORT=3306
DB_USER=app
DB_PASSWORD=apppass
DB_NAME=smartparking

# =========================
# RabbitMQ (Docker)
# Windows 호스트에서 node 실행 -> localhost로 접근
# =========================
RABBIT_URL=amqp://app:apppass@localhost:5672
RABBIT_QUEUE=ai.events

# =========================
# Camera / Device
# =========================
CAMERA_ONLINE_THRESHOLD_SEC=20

# =========================
# Anthropic Claude API
# =========================
ANTHROPIC_API_KEY=your-anthropic-api-key

# =========================
# 보안
# =========================
# 대시보드 주소(CORS 허용 목록, 쉼표 구분). 비우면 localhost:5173, 127.0.0.1:5173, 192.168.137.1:5173
# CORS_ORIGINS=http://localhost:5173,http://192.168.137.1:5173
# Lumi 로그인 토큰 검증 (기본값은 이 프로젝트)
# LUMI_PROJECT_ID=p379626134021566464
