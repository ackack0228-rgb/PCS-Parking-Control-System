      "description": "점검 시각"
    },
    "notes": {
      "bsonType": "string",
      "description": "점검 내용"
    },
    "creator": {
      "bsonType": "string",
      "description": "생성자"
    },
    "createdAt": {
      "bsonType": "string",
      "title": "datetime",
      "description": "생성일시"
