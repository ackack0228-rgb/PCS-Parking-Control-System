{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lumi: 프론트엔드 디버깅",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src",
      "sourceMapPathOverrides": {
        "webpack:///src/*": "${webRoot}/*"
      }
    },
    {
      "name": "Lumi: Deno Functions 디버깅",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Docker: MediaMTX 로그 확인",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/docker-compose",
      "args": ["logs", "-f", "mediamtx"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Lumi: 전체 디버깅",
      "configurations": ["Lumi: 프론트엔드 디버깅", "Lumi: Deno Functions 디버깅"]
    }
  ]
}
