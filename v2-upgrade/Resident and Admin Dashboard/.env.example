# 백엔드 REST API 주소 (smart-parking/backend, 포트 4000)
#   혼자 쓸 때: http://localhost:4000
#   iPad 등 다른 기기에서 접속할 때: http://<PC IP>:4000  (노트북 핫스팟이면 192.168.137.1)
VITE_BACKEND_URL=http://localhost:4000

# true 이면 Lumi Deno 엣지 함수(functions/backend-proxy)를 거쳐 백엔드를 호출
VITE_USE_DENO_PROXY=false

# MediaMTX HLS 스트림 주소 (CCTV 화면)
VITE_HLS_BASE_URL=http://localhost:8889

# AI 카메라 MJPEG 스트림 주소 (smart-parking/ai, 포트 8090)
VITE_MJPEG_BASE_URL=http://localhost:8090
