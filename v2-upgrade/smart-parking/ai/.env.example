# ================================================
# AI 카메라 서비스 설정 (cp .env.example .env)
# 기본값은 "서버와 AI를 같은 PC에서 실행"하는 경우다.
# ================================================

# 메인 서버(RabbitMQ가 떠 있는 PC)의 IP
#   같은 PC에서 실행: localhost
#   카메라 장치(Jetson 등)가 따로 있을 때: 메인 노트북 IP (예: 192.168.137.1)
SERVER_IP=localhost

# ── RabbitMQ ─────────────────────────────────────────────
# SERVER_IP를 설정하면 자동으로 반영됨. 직접 지정하려면 주석 해제
# RABBIT_URL=amqp://app:apppass@localhost:5672
RABBIT_QUEUE=ai.events

# ── 백엔드 API (MJPEG 영상 접근 시 관리자 토큰 확인용) ──
# 비우면 http://localhost:4000. 카메라 장치가 따로 있으면 메인 노트북 IP로
# BACKEND_URL=http://localhost:4000
# MJPEG_AUTH=off  # 영상 인증 끄기 (권장하지 않음)

# ── MediaMTX (CCTV 대시보드용 스트리밍) ─────────────────
# MEDIAMTX_HOST=localhost
MEDIAMTX_RTSP_PORT=8554

# ── 카메라 소스 ───────────────────────────────────────────
# 0 = 기본 웹캠 (USB 카메라, 노트북 카메라)
CAMERA_SOURCE=0
# CAMERA_SOURCE=/dev/video0                      # Linux 카메라 장치
# CAMERA_SOURCE=rtsp://192.168.0.20:8554/stream  # 외부 RTSP 스트림

# ── 카메라 / 장치 코드 ────────────────────────────────────
# CAM-GATE-01: seed.sql에 등록된 카메라 + 관리자 CCTV 화면이 MJPEG(8090)로 보여주는 카메라
# PI-01: seed.sql에 등록된 장치 코드 (수동 출차도 이 장치로 기록됨)
CAMERA_CODE=CAM-GATE-01
DEVICE_CODE=PI-01

# ── YOLOv8 모델 (확장용, 현재 실행 경로에서는 미사용) ────
YOLO_MODEL=yolov8n.pt

# ── 분석 설정 ─────────────────────────────────────────────
# 2초 간격 × 워밍업 20프레임 = 약 40초 배경 학습
FRAME_INTERVAL=2.0
CONFIDENCE_THRESHOLD=0.5
