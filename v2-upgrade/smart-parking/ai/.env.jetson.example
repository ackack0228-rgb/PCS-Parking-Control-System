# ================================================
# Jetson Orin Nano 전용 설정
# 이 파일을 .env 로 복사해서 사용:  cp .env.jetson.example .env
# ================================================

# 메인 노트북(서버) IP - 같은 와이파이에서 ipconfig로 확인
SERVER_IP=192.168.0.10

# RabbitMQ (SERVER_IP 기반으로 자동 설정됨)
RABBIT_QUEUE=ai.events

# 카메라 소스
# USB 웹캠: 0 또는 /dev/video0
# RTSP 스트림: rtsp://...
CAMERA_SOURCE=0

# 이 카메라의 이름 (DB cameras 테이블의 camera_code와 일치해야 함)
CAMERA_CODE=CAM-A-G-01
DEVICE_CODE=CAM-A-G-01

# Jetson GPU로 더 정확한 모델 사용 가능
# yolov8n.pt → yolov8s.pt → yolov8m.pt (정확도↑ 속도↓)
YOLO_MODEL=yolov8s.pt

# 0.5초마다 프레임 분석 (GPU 덕분에 Pi보다 4~6배 빠름)
FRAME_INTERVAL=0.5
CONFIDENCE_THRESHOLD=0.5

# FRAME_INTERVAL이 짧으니 타임아웃도 짧게 설정
# (FRAME_INTERVAL * 10 정도 권장)
SPOT_CLEAR_TIMEOUT=5.0
